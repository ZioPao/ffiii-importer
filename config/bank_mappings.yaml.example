# Global transfer rules — matched against any bank's transactions.
# Define once here instead of repeating per bank.
# `from_account_id` is optional: if set, the rule only fires when the source account matches.
# transfers:
#   - pattern: "transfer to savings"
#     to_account_id: "3"             # matches regardless of which bank CSV it comes from
#   - pattern: "^internal transfer"
#     from_account_id: "1"           # only when coming from account 1
#     to_account_id: "4"

banks:
  # Example: single-amount column bank (positive = income, negative = expense)
  my_bank:
    account_id: "1"                # Firefly asset account ID
    encoding: "utf-8"
    delimiter: ","
    skip_rows: 0                   # rows to skip before the header row
    date_format: "%d/%m/%Y"
    amount_column_type: "single"   # one column; negative value = expense
    columns:
      date: "Transaction Date"
      description: "Description"
      amount: "Amount"
      notes: "Reference"           # optional
      # currency: "Currency"       # optional; uses Firefly account default if absent

  # Example: split debit/credit columns bank
  another_bank:
    account_id: "2"
    encoding: "latin-1"
    delimiter: ";"
    skip_rows: 1
    date_format: "%Y-%m-%d"
    amount_column_type: "split"    # separate debit/credit columns
    columns:
      date: "Datum"
      description: "Omschrijving"
      debit: "Af"                  # money leaving the account (positive value in CSV)
      credit: "Bij"                # money entering the account (positive value in CSV)
